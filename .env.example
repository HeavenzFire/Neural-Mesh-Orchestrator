# Sovereign Core Shield - Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.

# === Application ===
ENV=development
# ENV=staging
# ENV=production

# === Database (PostgreSQL with asyncpg driver) ===
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sovereign_shield_db

# === Plaid (Bank Account Verification) ===
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here

# === Stripe (Payment Processing) ===
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# === Twilio (SMS/Voice Communications) ===
TWILIO_ACCOUNT_SID=AC_your_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# === Lob (Direct Mail Automation) ===
LOB_API_KEY=test_your_lob_api_key_here
# Use test_ prefix for sandbox, live_ prefix for production

# === HIPAA Compliance (Required for production) ===
# Generate a random 32+ character string for AES-256 encryption
HIPAA_ENCRYPTION_KEY=your_super_secure_random_encryption_key_at_least_32_chars_long

# === AWS (Optional - for S3/Secrets Manager) ===
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# === Logging ===
LOG_LEVEL=INFO
